# Copy to `.env` and adjust. Nest apps load `.env` from the workspace root via
# @nestjs/config; Nuxt reads NUXT_* variables at runtime.

# api-gateway
PORT=3000
CORS_ORIGIN=http://localhost:4200
# Proxies allowed to set X-Forwarded-For (Express "trust proxy" syntax)
TRUST_PROXY=loopback
# Rate limit per client IP: THROTTLE_LIMIT requests per THROTTLE_TTL_MS
THROTTLE_LIMIT=120
THROTTLE_TTL_MS=60000
# Max JSON body size
BODY_LIMIT=100kb
# Signs session tokens. Required in production, at least 32 characters
# (e.g. `openssl rand -base64 48`). Unset in dev: a random one per restart.
# JWT_SECRET=
# Send the session cookie over HTTPS only. Defaults to true in production.
# COOKIE_SECURE=false

# Microservice addresses (used by the services to bind, and by the gateway to connect).
# Services bind to 127.0.0.1 by default; never expose their ports publicly.
USERS_SERVICE_HOST=localhost
USERS_SERVICE_PORT=3001
ORDERS_SERVICE_HOST=localhost
ORDERS_SERVICE_PORT=3002
PRODUCTS_SERVICE_HOST=localhost
PRODUCTS_SERVICE_PORT=3003
BUYERS_SERVICE_HOST=localhost
BUYERS_SERVICE_PORT=3004

# web (Nuxt) — where the server-side /api proxy forwards to
NUXT_API_BASE_URL=http://localhost:3000/api
# Use the client IP reported by a load balancer in front of Nuxt (only if you have one)
NUXT_TRUST_FORWARDED_FOR=false
