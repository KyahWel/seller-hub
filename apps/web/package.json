{
  "name": "@org/web",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "nx": {
    "tags": [
      "type:app",
      "scope:web"
    ],
    "targets": {
      "typecheck": {
        "command": "nuxt typecheck",
        "options": {
          "cwd": "{projectRoot}"
        },
        "cache": true,
        "inputs": [
          "default",
          "^production"
        ]
      },
      "preview": {
        "command": "node .output/server/index.mjs",
        "dependsOn": [
          "build"
        ],
        "continuous": true,
        "options": {
          "cwd": "{projectRoot}",
          "env": {
            "HOST": "localhost",
            "PORT": "4200"
          }
        }
      }
    }
  },
  "dependencies": {
    "@org/contracts": "*"
  }
}
